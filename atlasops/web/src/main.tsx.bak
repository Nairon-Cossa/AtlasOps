import React,{useCallback,useEffect,useMemo,useState} from 'react';
import{createRoot}from'react-dom/client';
import {Activity,BarChart3,BriefcaseBusiness,Building2,Check,ChevronDown,ChevronRight,CircleDollarSign,ClipboardList,Clock3,CloudUpload,FileCheck2,Headset,LayoutDashboard,Lightbulb,LockKeyhole,LogOut,Menu,MoreHorizontal,Phone,Plus,RefreshCcw,Search,Settings,ShieldCheck,Smartphone,TrendingUp,Users,Wallet,X} from'lucide-react';
import {api,money,shortDate,value,userCanWrite,localStamp,type Actor,type Session,type RecordItem} from './api';
import {resources,friendly,type Field}from './resources';
import './styles.css';
import AuthPanel from './AuthPanel';
type ListResult={items:RecordItem[];pagination?:{limit:number;offset:number}};
type Insight={severity:'warning'|'info';title:string;recommendation:string;basis:Record<string,unknown>};
type Overview={period_days:number;metrics:Record<string,unknown>;daily_calls:{day:string;calls:number}[];insights:{engine:string;connection_rate_percent:number;findings:Insight[]}};
const ICONS:Record<string,React.ElementType>={overview:LayoutDashboard,employees:Users,sims:Smartphone,customers:Building2,leads:TrendingUp,deals:BriefcaseBusiness,tasks:ClipboardList,expenses:Wallet,revenue:CircleDollarSign,calls:Phone,transcripts:Headset,devices:Smartphone,carrier:CloudUpload,insights:Lightbulb,users:ShieldCheck,audit:FileCheck2,settings:Settings};
const LABELS:Record<string,string>={overview:'Visão geral',employees:'Equipa',sims:'SIMs',customers:'Clientes',leads:'Leads',deals:'Negócios',tasks:'Tarefas',expenses:'Despesas',revenue:'Receitas',calls:'Chamadas',transcripts:'Revisão de chamadas',devices:'Dispositivos',carrier:'Operadoras',insights:'Inteligência',users:'Acessos',audit:'Auditoria',settings:'Definições'};
const GROUPS=[['Workspace',['overview','insights','calls','transcripts']],['Comercial',['leads','deals','customers','tasks']],['Operações',['employees','sims','devices','carrier']],['Financeiro',['revenue','expenses']],['Administração',['users','audit','settings']]] as const;
function allowed(tab:string,role:string){if(role==='agent')return !['transcripts','sims','devices','carrier','expenses','revenue','users','audit','employees'].includes(tab);if(role==='analyst')return !['users','audit','settings'].includes(tab)||tab==='settings';if(role==='manager')return !['users','audit'].includes(tab);return true;}
function useNotice(){const [notice,setNotice]=useState<{message:string;bad:boolean}|null>(null);const ok=(message:string)=>setNotice({message,bad:false});const bad=(e:unknown)=>setNotice({message:e instanceof Error?e.message:String(e),bad:true});return {notice,setNotice,ok,bad};}
function Status({text}:{text:unknown}){const t=String(text||'—');const positive=['active','won','qualified','converted','confirmed','done','meeting_booked','carrier_api'];const danger=['lost','cancelled','disabled','revoked','suspended','reversed'];return <span className={'status '+(positive.includes(t)?'green':danger.includes(t)?'red':'neutral')}>{t.replaceAll('_',' ')}</span>;}
function formatCell(k:string,v:unknown){if(k==='status'||k==='stage'||k==='priority'||k==='evidence'||k==='outcome'||k==='direction')return <Status text={v}/>;if(k.endsWith('_mzn'))return money(v);if(k.endsWith('_at')||k==='created_at')return shortDate(v);if(v===null||v===undefined)return <span className="muted">—</span>;return String(v);}
function Modal({title,children,onClose}:{title:string;children:React.ReactNode;onClose:()=>void}){return <div className="overlay" onMouseDown={onClose}><div className="modal" role="dialog" aria-modal="true" aria-label={title} onMouseDown={e=>e.stopPropagation()}><header><div><div className="eyebrow dark">ATLASOPS WORKSPACE</div><h2>{title}</h2></div><button className="icon-button" onClick={onClose} aria-label="Fechar"><X size={20}/></button></header>{children}</div></div>;}
function RecordForm({kind,original,onDone,onClose,session}:{kind:string;original?:RecordItem;onDone:()=>void;onClose:()=>void;session:Session}){
 const config=resources[kind];const [input,setInput]=useState<Record<string,string>>(()=>Object.fromEntries(config.fields.map(f=>[f.key,original?.[f.key]===null||original?.[f.key]===undefined?'':f.type==='date'?new Date(String(original?.[f.key])).toISOString().slice(0,16):String(original?.[f.key])])));
 const [refs,setRefs]=useState<Record<string,RecordItem[]>>({});const [working,setWorking]=useState(false);const {notice,bad}=useNotice();
 useEffect(()=>{for(const f of config.fields){if(f.ref){if(f.ref==='users')api<{items:RecordItem[]}>('/auth/users').then(r=>setRefs(p=>({...p,users:r.items}))).catch(()=>{});else api<ListResult>(resources[f.ref]?.endpoint??'/data/'+f.ref).then(r=>setRefs(p=>({...p,[f.ref!]:r.items}))).catch(()=>{});}}},[kind]);
 async function save(e:React.FormEvent){e.preventDefault();setWorking(true);try{
  const body:Record<string,unknown>={};for(const f of config.fields){const raw=input[f.key]?.trim();if(!raw){if(f.required)throw new Error(f.label+' é obrigatório.');if(original&&original[f.key]!==undefined)body[f.key]=null;continue;}body[f.key]=f.type==='number'?Number(raw):f.type==='date'?new Date(raw).toISOString():raw;}
  await api(config.endpoint+(original?'/'+original.id:''),original?'PATCH':'POST',body);onDone();onClose();
 }catch(e){bad(e);}finally{setWorking(false);}}
 return <Modal title={original?'Editar registo':'Novo registo · '+LABELS[kind]} onClose={onClose}><form className="record-form" onSubmit={save}>{notice&&<p className="error">{notice.message}</p>}<div className="form-grid">{config.fields.map(f=><label className={f.type==='textarea'?'wide':''} key={f.key}>{f.label}{f.required&&<sup>*</sup>}{f.type==='select'?<select required={f.required} value={input[f.key]??''} onChange={e=>setInput({...input,[f.key]:e.target.value})}><option value="">— Seleccionar —</option>{f.ref?(refs[f.ref]||[]).map(item=><option key={item.id} value={item.id}>{String(item.full_name||item.name||item.title||item.email||item.phone_e164||item.id)}</option>):f.options?.map(v=><option key={v} value={v}>{v.replaceAll('_',' ')}</option>)}</select>:f.type==='textarea'?<textarea rows={3} value={input[f.key]||''} onChange={e=>setInput({...input,[f.key]:e.target.value})}/>:<input required={f.required} type={f.type==='number'?'number':f.type==='email'?'email':f.type==='date'?'datetime-local':'text'} step={f.type==='number'?'any':undefined} min={f.type==='number'?0:undefined} value={input[f.key]||''} onChange={e=>setInput({...input,[f.key]:e.target.value})}/>}</label>)}</div><div className="modal-actions"><button type="button" className="secondary" onClick={onClose}>Cancelar</button><button disabled={working} className="primary">{working?'A guardar...':'Guardar registo'} <Check size={16}/></button></div></form></Modal>;
}
function Collection({kind,session}:{kind:string;session:Session}){
 const cfg=resources[kind];const [data,setData]=useState<RecordItem[]>([]);const[busy,setBusy]=useState(true);const[search,setSearch]=useState('');const[editing,setEditing]=useState<RecordItem|null|undefined>(undefined);const[page,setPage]=useState(0);const {notice,ok,bad,setNotice}=useNotice();
 const load=useCallback(async()=>{setBusy(true);try{const r=await api<ListResult>(cfg.endpoint+'?limit=100&offset='+page*100);setData(r.items);setNotice(null);}catch(e){bad(e);}finally{setBusy(false);}},[kind,page]);useEffect(()=>{load();},[load]);
 const filtered=useMemo(()=>data.filter(r=>JSON.stringify(r).toLowerCase().includes(search.toLowerCase())),[data,search]);
 const writable=userCanWrite(session.user.role,kind);const editable=writable&&session.user.role!=='agent'&&kind!=='calls';
 async function del(item:RecordItem){if(!confirm('Eliminar este registo? Esta operação não pode ser desfeita.'))return;try{await api(cfg.endpoint+'/'+item.id,'DELETE');ok('Registo eliminado.');load();}catch(e){bad(e);}}
 return <div className="page"><div className="page-head"><div><div className="eyebrow dark">GESTÃO DE DADOS</div><h1>{cfg.title}</h1><p>{cfg.sub}</p></div>{writable&&<button className="primary" onClick={()=>setEditing(null)}><Plus size={17}/> Novo registo</button>}</div>{notice&&<div className={notice.bad?'error':'success'}>{notice.message}</div>}<div className="panel"><div className="panel-head"><div className="panel-title"><h3>Registos</h3><span className="count">{filtered.length}</span></div><div className="toolbar"><div className="search"><Search size={16}/><input placeholder="Pesquisar..." aria-label="Pesquisar" value={search} onChange={e=>setSearch(e.target.value)}/></div><button className="icon-button" onClick={load} aria-label="Actualizar"><RefreshCcw size={17}/></button></div></div><div className="table-wrap"><table><thead><tr>{cfg.columns.map(k=><th key={k}>{friendly(k)}</th>)}{editable&&<th>Acções</th>}</tr></thead><tbody>{filtered.map(item=><tr key={item.id}>{cfg.columns.map(k=><td key={k}>{formatCell(k,item[k])}</td>)}{editable&&<td className="actions"><button className="text-button" onClick={()=>setEditing(item)}>Editar</button>{session.user.role==='owner'&&!['expenses','revenue','calls'].includes(kind)&&<button className="text-button danger" onClick={()=>del(item)}>Eliminar</button>}</td>}</tr>)}{!filtered.length&&<tr><td colSpan={cfg.columns.length+1} className="empty-cell">{busy?'A carregar registos...':'Ainda não há dados. Os relatórios permanecem vazios até serem registadas operações reais.'}</td></tr>}</tbody></table></div><div className="table-footer"><span>Máximo 100 registos por página</span><div className="page-buttons"><button className="secondary small" onClick={()=>setPage(Math.max(0,page-1))} disabled={!page}>Anterior</button><span>{page+1}</span><button className="secondary small" onClick={()=>setPage(page+1)} disabled={data.length<100}>Próxima</button></div></div></div>{editing!==undefined&&<RecordForm kind={kind} original={editing??undefined} onClose={()=>setEditing(undefined)} onDone={()=>{load();ok('Registo guardado.');}} session={session}/>}</div>;
}
function OverviewPage({session,setTab}:{session:Session;setTab:(t:string)=>void}){
 const [overview,setOverview]=useState<Overview|null>(null);const[busy,setBusy]=useState(true);const[days,setDays]=useState(30);const{notice,bad}=useNotice();
 useEffect(()=>{setBusy(true);api<Overview>('/analytics/overview?days='+days).then(setOverview).catch(bad).finally(()=>setBusy(false));},[days]);
 const m=overview?.metrics||{};const metrics=[{title:'Chamadas registadas',value:Number(m.calls||0).toLocaleString('pt-MZ'),icon:Phone,hint:'Actividade no período'},{title:'Tempo de chamadas',value:Math.round(Number(m.seconds||0)/60).toLocaleString('pt-MZ')+' min',icon:Clock3,hint:'Duração total'},{title:'Leads qualificados',value:String(m.qualified_leads||0),icon:TrendingUp,hint:'Registados no CRM'},{title:'Receita confirmada',value:money(m.revenue),icon:CircleDollarSign,hint:'Registos declarados / integrados'}];
 const daily=overview?.daily_calls||[],max=Math.max(1,...daily.map(d=>d.calls));
 return <div className="page"><div className="page-head"><div><div className="eyebrow dark">PAINEL DE CONTROLO · {session.organization.name.toUpperCase()}</div><h1>Bom dia, {session.user.full_name.split(' ')[0]} <span className="wave">✳</span></h1><p>Uma visão clara de actividade, desempenho e resultados reais.</p></div><div className="segmented">{[7,30,90].map(n=><button key={n} className={days===n?'active':''} onClick={()=>setDays(n)}>{n} dias</button>)}</div></div>{notice&&<div className="error">{notice.message}</div>}<div className="hero-strip"><div><span><span className="dot light"/> CENTRO DE OPERAÇÕES</span><h2>Da actividade ao resultado.</h2><p>As métricas vêm apenas de registos introduzidos ou sincronizados. Sem números fictícios.</p></div><button onClick={()=>setTab('insights')}>Ver inteligência <ChevronRight size={17}/></button><div className="hero-glow"/></div><div className="metrics">{metrics.map((item,i)=><div className="metric-card" key={item.title}><div className="metric-top"><span>{item.title}</span><div className={'metric-icon metric-'+i}><item.icon size={19}/></div></div><div className="metric-number">{busy?'—':item.value}</div><div className="metric-caption">{item.hint}</div></div>)}</div><div className="dashboard-grid"><div className="panel"><div className="panel-head"><div><h3>Actividade de chamadas</h3><p>Volume diário no período seleccionado</p></div><div className="legend"><i/> Chamadas</div></div><div className="bars" role="img" aria-label="Chamadas diárias">{daily.length?daily.slice(-30).map(d=><div key={d.day} className="bar-column" title={`${d.day}: ${d.calls}`}><div className="bar-track"><div style={{height:(d.calls/max*100)+'%'}} className="bar-fill"/></div><small>{d.day.slice(8)}</small></div>):<div className="empty-graph"><BarChart3 size={32}/><b>Sem actividade registada</b><span>As chamadas aparecerão aqui quando forem sincronizadas.</span></div>}</div></div><div className="panel insights-spot"><div className="panel-head"><div><h3>Recomendações</h3><p>Explicáveis e baseadas em dados</p></div><Lightbulb size={19}/></div><div className="insight-items">{overview?.insights.findings.slice(0,4).map((it,i)=><div className="insight-item" key={i}><span className={'insight-indicator '+it.severity}/><div><strong>{it.title}</strong><p>{it.recommendation}</p></div></div>)}{!overview&&<p className="muted">A carregar...</p>}</div><button className="linkline" onClick={()=>setTab('insights')}>Abrir relatório completo <ChevronRight size={16}/></button></div></div><div className="mini-stats"><div><span>Chamadas atendidas</span><b>{Number(m.answered || 0)}</b></div><div><span>Taxa de ligação</span><b>{overview?.insights.connection_rate_percent??0}%</b></div><div><span>Custo real de chamadas registado</span><b>{money(m.known_call_cost_mzn)}</b></div><div><span>Custo de chamadas estimado</span><b>{money(m.estimated_call_cost_mzn)}</b></div></div></div>;
}
function InsightsPage(){const[overview,setOverview]=useState<Overview|null>(null);const[staff,setStaff]=useState<RecordItem[]>([]);const{notice,bad}=useNotice();useEffect(()=>{api<Overview>('/analytics/overview?days=30').then(setOverview).catch(bad);api<ListResult>('/analytics/employee-performance').then(x=>setStaff(x.items)).catch(bad);},[]);return <div className="page"><div className="page-head"><div><div className="eyebrow dark">INTELIGÊNCIA OPERACIONAL</div><h1>Insights & Performance</h1><p>Recomendações baseadas em dados, acompanhadas da evidência.</p></div><span className="small-chip"><Lightbulb size={15}/> Motor explicável v1</span></div>{notice&&<div className="error">{notice.message}</div>}<div className="panel"><div className="panel-head"><div><h3>Diagnóstico · últimos 30 dias</h3><p>Sem transcrições ou gravações de chamadas</p></div></div><div className="diagnostics">{overview?.insights.findings.map((i,n)=><div className="diagnostic" key={n}><div className={'diagnostic-icon '+i.severity}><Lightbulb size={19}/></div><div><h4>{i.title}</h4><p>{i.recommendation}</p><div className="evidence">Evidência: {Object.entries(i.basis).map(([k,v])=>`${k.replaceAll('_',' ')}: ${v}`).join(' · ')}</div></div></div>)}{!overview&&<p className="muted">A carregar relatório...</p>}</div></div><div className="panel"><div className="panel-head"><div><h3>Desempenho da equipa</h3><p>Resultados dos últimos 30 dias por funcionário</p></div></div><div className="table-wrap"><table><thead><tr><th>Funcionário</th><th>Chamadas</th><th>Minutos</th><th>Leads qualificados</th><th>Negócios ganhos</th></tr></thead><tbody>{staff.map(x=><tr key={x.id}><td><b>{value(x.full_name)}</b><div className="muted tiny">{value(x.department)}</div></td><td>{value(x.calls)}</td><td>{Math.round(Number(x.call_seconds||0)/60)}</td><td>{value(x.qualified_leads)}</td><td>{value(x.won_deals)}</td></tr>)}{!staff.length&&<tr><td colSpan={5} className="empty-cell">Sem funcionários registados.</td></tr>}</tbody></table></div></div></div>}
function DevicesPage(){const [items,setItems]=useState<RecordItem[]>([]);const[employees,setEmployees]=useState<RecordItem[]>([]);const[sims,setSims]=useState<RecordItem[]>([]);const[employeeId,setEmployeeId]=useState('');const[simId,setSimId]=useState('');const[label,setLabel]=useState('Android comercial');const[issued,setIssued]=useState('');const{notice,ok,bad}=useNotice();const load=()=>{api<ListResult>('/devices').then(x=>setItems(x.items)).catch(bad);};useEffect(()=>{load();api<ListResult>('/data/employees').then(x=>setEmployees(x.items)).catch(bad);api<ListResult>('/data/sims').then(x=>setSims(x.items)).catch(bad);},[]);async function issue(e:React.FormEvent){e.preventDefault();try{const x=await api<{enrollmentToken:string}>('/devices/enrollment','POST',{employeeId,simId,deviceLabel:label});setIssued(x.enrollmentToken);ok('Código válido durante 30 minutos. Copie agora.');}catch(e){bad(e);}}async function revoke(id:string){if(!confirm('Revogar acesso deste dispositivo?'))return;try{await api('/devices/'+id+'/revoke','POST',{});ok('Dispositivo revogado.');load();}catch(e){bad(e);}}return <div className="page"><div className="page-head"><div><div className="eyebrow dark">APARELHOS EMPRESARIAIS</div><h1>Dispositivos Android</h1><p>Ligue equipamentos autorizados ao SIM corporativo.</p></div></div>{notice&&<div className={notice.bad?'error':'success'}>{notice.message}</div>}<div className="two-panels"><div className="panel padded"><h3>Inscrever novo dispositivo</h3><p>É gerado um código de utilização única.</p><form className="vertical-form" onSubmit={issue}><label>Funcionário<select required value={employeeId} onChange={e=>setEmployeeId(e.target.value)}><option value="">Seleccione</option>{employees.map(x=><option key={x.id} value={x.id}>{String(x.full_name)}</option>)}</select></label><label>SIM empresarial<select required value={simId} onChange={e=>setSimId(e.target.value)}><option value="">Seleccione um SIM empresarial</option>{sims.map(x=><option key={x.id} value={x.id}>{String(x.phone_e164)} · {String(x.carrier)}</option>)}</select></label><label>Identificação do dispositivo<input required value={label} onChange={e=>setLabel(e.target.value)}/></label><button className="primary">Gerar código seguro <Plus size={16}/></button></form>{issued&&<div className="token-box"><strong>Código de inscrição (mostrar uma vez)</strong><code>{issued}</code><button className="secondary small" onClick={()=>navigator.clipboard.writeText(issued)}>Copiar código</button></div>}</div><div className="panel padded"><div className="notice-info"><ShieldCheck/><div><h3>Transparência dos dados</h3><p>Chamadas enviadas por um dispositivo são marcadas como <b>device_reported</b>. Só o operador pode confirmar de forma independente a utilização da rede.</p></div></div><div className="notice-info"><LockKeyhole/><div><h3>Proteção</h3><p>Tokens aleatórios, revogação imediata, transmissão HTTPS e isolamento por empresa.</p></div></div></div></div><div className="panel"><div className="panel-head"><h3>Dispositivos inscritos</h3><button className="icon-button" onClick={load}><RefreshCcw size={17}/></button></div><div className="table-wrap"><table><thead><tr><th>Dispositivo</th><th>Funcionário</th><th>Estado</th><th>Última sincronização</th><th>Acções</th></tr></thead><tbody>{items.map(x=><tr key={x.id}><td>{String(x.device_label)}</td><td>{String(x.employee_name||'—')}</td><td><Status text={x.status}/></td><td>{shortDate(x.last_synced_at)}</td><td><button className="text-button danger" onClick={()=>revoke(String(x.id))} disabled={x.status==='revoked'}>Revogar</button></td></tr>)}{!items.length&&<tr><td colSpan={5} className="empty-cell">Sem dispositivos.</td></tr>}</tbody></table></div></div></div>}
function CarrierPage(){const [imports,setImports]=useState<RecordItem[]>([]);const[carrier,setCarrier]=useState('Vodacom');const[text,setText]=useState('[\n  {"simId":"", "externalReference":"", "remotePhoneE164":"+258", "direction":"outgoing", "startedAt":"2026-11-14T10:00:00+02:00", "durationSeconds":60, "actualCostMzn":5.00}\n]');const{notice,ok,bad}=useNotice();const load=()=>api<ListResult>('/carrier/imports').then(x=>setImports(x.items)).catch(bad);useEffect(()=>{load();},[]);async function submit(e:React.FormEvent){e.preventDefault();try{const rows=JSON.parse(text);if(!Array.isArray(rows))throw new Error('É necessário um array JSON.');const r=await api<{inserted:number;updated:number;skipped:number}>('/carrier/statement-import','POST',{carrier,filename:'manual-statement.json',rows});ok(`Importados: ${r.inserted} · Conciliados: ${r.updated} · Ignorados: ${r.skipped}`);load();}catch(e){bad(e);}}return <div className="page"><div className="page-head"><div><div className="eyebrow dark">CONCILIAÇÃO DE OPERADORAS</div><h1>Importar extratos de chamadas</h1><p>Concilie dados do telefone com relatórios da operadora.</p></div></div>{notice&&<div className={notice.bad?'error':'success'}>{notice.message}</div>}<div className="two-panels"><div className="panel padded"><h3>Importar linhas de extracto</h3><p>Formato JSON; máx. 500 linhas por lote. O identificador da SIM deve existir no workspace.</p><form onSubmit={submit} className="vertical-form"><label>Operadora<select value={carrier} onChange={e=>setCarrier(e.target.value)}>{['Vodacom','Movitel','Tmcel','Other'].map(x=><option key={x}>{x}</option>)}</select></label><label>Dados do extracto<textarea rows={12} spellCheck={false} className="code-input" value={text} onChange={e=>setText(e.target.value)}/></label><button className="primary">Importar e conciliar <CloudUpload size={16}/></button></form></div><div className="panel padded"><div className="notice-info"><ShieldCheck/><div><h3>Proveniência fiável</h3><p>Importações manuais são marcadas como <b>carrier_statement</b>, não como verificadas. Apenas uma integração autenticada do operador pode atribuir <b>carrier_api</b>.</p></div></div><div className="notice-info"><FileCheck2/><div><h3>Conciliação conservadora</h3><p>Comparação por SIM, número, horário e duração. Registos ambíguos nunca são associados automaticamente.</p></div></div></div></div><div className="panel"><div className="panel-head"><h3>Histórico de importações</h3></div><div className="table-wrap"><table><thead><tr><th>Operadora</th><th>Linhas</th><th>Novas</th><th>Conciliadas</th><th>Data</th></tr></thead><tbody>{imports.map(x=><tr key={x.id}><td>{value(x.carrier)}</td><td>{value(x.rows_received)}</td><td>{value(x.rows_inserted)}</td><td>{value(x.rows_updated)}</td><td>{shortDate(x.created_at)}</td></tr>)}{!imports.length&&<tr><td colSpan={5} className="empty-cell">Sem importações.</td></tr>}</tbody></table></div></div></div>}

function TranscriptPage({session}:{session:Session}){
 const [items,setItems]=useState<RecordItem[]>([]);const[calls,setCalls]=useState<RecordItem[]>([]);
 const [callId,setCallId]=useState('');const[source,setSource]=useState('Authorized business recording');
 const [consentBasis,setConsentBasis]=useState('');const [transcript,setTranscript]=useState('');
 const [attest,setAttest]=useState(false);const [externalAgree,setExternalAgree]=useState(false);
 const [working,setWorking]=useState(false);const {notice,ok,bad}=useNotice();
 const canModify=['owner','admin','manager'].includes(session.user.role);
 const load=()=>api<ListResult>('/intelligence/transcripts').then(x=>setItems(x.items)).catch(bad);
 useEffect(()=>{load();if(canModify)api<ListResult>('/calls?limit=100').then(x=>setCalls(x.items)).catch(bad);},[]);
 async function submit(e:React.FormEvent){e.preventDefault();if(!attest){bad(new Error('Confirme o consentimento antes de continuar.'));return;}setWorking(true);try{
  await api('/intelligence/transcripts','POST',{callId,transcript,recordingSource:source,consentBasis,consentRecordedAt:new Date().toISOString(),complianceAttestation:true});
  ok('Transcrição cifrada e guardada.');setTranscript('');setCallId('');setAttest(false);load();
 }catch(e){bad(e);}finally{setWorking(false);}}
 async function analyze(id:string){if(!externalAgree){bad(new Error('Confirme a autorização para processamento externo por IA.'));return;}setWorking(true);try{
  await api('/intelligence/transcripts/'+id+'/analyze','POST',{externalAiProcessingApproved:true});ok('Análise guardada.');load();
 }catch(e){bad(e);}finally{setWorking(false);}}
 async function remove(id:string){if(!confirm('Eliminar permanentemente a transcrição e a análise?'))return;try{await api('/intelligence/transcripts/'+id,'DELETE');ok('Transcrição eliminada.');load();}catch(e){bad(e);}}
 return <div className="page"><div className="page-head"><div><div className="eyebrow dark">QUALIDADE COMERCIAL · IA OPCIONAL</div><h1>Revisão de chamadas</h1><p>Analise transcrições provenientes apenas de fontes legitimamente autorizadas.</p></div></div>
 {notice&&<div className={notice.bad?'error':'success'}>{notice.message}</div>}
 <div className="two-panels">
 {canModify&&<div className="panel padded"><h3>Adicionar transcrição autorizada</h3><p>A aplicação de SIM não capta nem grava áudio. Este módulo recebe transcrições obtidas separadamente.</p>
 <form className="vertical-form" onSubmit={submit}>
 <label>Chamada associada<select required value={callId} onChange={e=>setCallId(e.target.value)}><option value="">Seleccione uma chamada registada</option>{calls.map(c=><option key={c.id} value={c.id}>{String(c.remote_phone_e164)} · {shortDate(c.started_at)} · {String(c.evidence)}</option>)}</select></label>
 <label>Fonte da gravação<input required value={source} onChange={e=>setSource(e.target.value)}/></label>
 <label>Base do consentimento / base legal<input required minLength={8} value={consentBasis} onChange={e=>setConsentBasis(e.target.value)} placeholder="Descreva a autorização e o procedimento"/></label>
 <label>Transcrição<textarea required minLength={30} rows={7} value={transcript} onChange={e=>setTranscript(e.target.value)} placeholder="Escreva ou cole a transcrição obtida de forma legal..."/></label>
 <label className="checkbox-label"><input type="checkbox" checked={attest} onChange={e=>setAttest(e.target.checked)}/> Confirmo que este conteúdo foi obtido e comunicado legalmente às partes.</label>
 <button className="primary" disabled={working}>Guardar com cifragem <LockKeyhole size={16}/></button></form></div>}
 <div className="panel padded"><div className="notice-info"><ShieldCheck/><div><h3>Consentimento e transparência</h3><p>Um operador da empresa confirma a base legal. O sistema não consegue verificar autonomamente o consentimento dos participantes.</p></div></div><div className="notice-info"><Lightbulb/><div><h3>IA opcional</h3><p>Para processar o texto por IA, configure OPENAI_API_KEY, OPENAI_MODEL e uma chave de cifragem no servidor. A análise é aconselhamento, não verdade comprovada.</p></div></div><label className="checkbox-label"><input type="checkbox" checked={externalAgree} onChange={e=>setExternalAgree(e.target.checked)}/> Autorizo o envio das transcrições seleccionadas ao fornecedor de IA externo.</label></div>
 </div>
 <div className="panel"><div className="panel-head"><h3>Transcrições registadas</h3><span className="count">{items.length}</span></div>
 <div className="transcript-list">{items.map(item=>{const a=item.ai_analysis as RecordItem|null;return <div className="transcript-card" key={item.id}><div className="transcript-head"><div><b>Chamada {String(item.call_id).slice(0,8)}</b><p>{String(item.recording_source)} · {shortDate(item.created_at)}</p></div><div className="transcript-actions">{canModify&&<button className="secondary small" disabled={working} onClick={()=>analyze(String(item.id))}><Lightbulb size={14}/> Analisar com IA</button>}{['owner','admin'].includes(session.user.role)&&<button className="text-button danger" onClick={()=>remove(String(item.id))}>Eliminar</button>}</div></div>{a?<div className="analysis-result"><strong>{String(a.summary)}</strong><div className="analysis-scores"><span>Profissionalismo: {String(a.professionalism)}/5</span><span>Descoberta: {String(a.discovery)}/5</span><span>Próximo passo: {String(a.nextStep)}/5</span></div><div className="muted tiny">Pontos fortes: {Array.isArray(a.strengths)?a.strengths.join(' · '):'—'}</div><div className="muted tiny">A melhorar: {Array.isArray(a.improvements)?a.improvements.join(' · '):'—'}</div><div className="tiny">Intenção estimada: {String(a.leadIntent)} · Confiança: {String(a.confidence)}</div></div>:<p className="muted tiny">Ainda não analisada por IA.</p>}</div>})}{!items.length&&<p className="empty-cell">Sem transcrições. A importação de áudio não é automática.</p>}</div>
 </div></div>;
}

function UsersPage(){
 const [items,setItems]=useState<RecordItem[]>([]);
 const [email,setEmail]=useState('');const [fullName,setFullName]=useState('');
 const [password,setPassword]=useState('');const [role,setRole]=useState('agent');
 const [mail,setMail]=useState(false);const[busy,setBusy]=useState(false);
 const{notice,ok,bad}=useNotice();
 const load=()=>api<{items:RecordItem[]}>('/auth/users').then(x=>setItems(x.items)).catch(bad);
 useEffect(()=>{
  load();
  api<{staffInvites:boolean}>('/auth/config').then(c=>setMail(c.staffInvites)).catch(()=>{});
 },[]);
 async function add(e:React.FormEvent){
  e.preventDefault();setBusy(true);
  try{
   await api('/auth/users','POST',{email,fullName,role,...(!mail?{password}:{})});
   ok(mail?'Convite enviado. A conta ficará desactivada até o colaborador aceitar.':'Conta criada para testes locais. Entregue a palavra-passe por um canal seguro.');
   setEmail('');setFullName('');setPassword('');load();
  }catch(e){bad(e);}finally{setBusy(false);}
 }
 async function resend(item:RecordItem){
  try{await api('/auth/users/'+item.id+'/resend-invite','POST',{});ok('O convite foi reenviado.');}
  catch(e){bad(e);}
 }
 async function toggle(item:RecordItem){
  try{await api('/auth/users/'+item.id,'PATCH',{status:item.status==='active'?'disabled':'active'});ok('Conta actualizada.');load();}
  catch(e){bad(e);}
 }
 return <div className="page">
  <div className="page-head"><div><div className="eyebrow dark">CONTROLO DE ACESSO</div>
    <h1>Utilizadores & permissões</h1><p>Proprietário, administrador, gestor, analista e agente.</p></div></div>
  {notice&&<div className={notice.bad?'error':'success'}>{notice.message}</div>}
  <div className="two-panels">
    <div className="panel padded"><h3>{mail?'Convidar colaborador por email':'Criar conta de teste'}</h3>
      <p>{mail?'O funcionário recebe uma ligação individual válida durante 24 horas e escolhe a sua palavra-passe.':
        'O serviço de email ainda não foi configurado. No ambiente local, pode criar contas com palavra-passe temporária. Não use este fluxo em produção.'}</p>
      <form className="vertical-form" onSubmit={add}>
        <label>Nome completo<input value={fullName} onChange={e=>setFullName(e.target.value)} minLength={2} required/></label>
        <label>Email<input type="email" value={email} onChange={e=>setEmail(e.target.value)} required/></label>
        {!mail&&<label>Palavra-passe temporária (12+ caracteres)<input type="password" minLength={12} maxLength={128} value={password} onChange={e=>setPassword(e.target.value)} required/></label>}
        <label>Papel<select value={role} onChange={e=>setRole(e.target.value)}>
          {['agent','analyst','manager','admin'].map(x=><option key={x} value={x}>{x}</option>)}
        </select></label>
        <button className="primary" disabled={busy}>{busy?'A processar...':mail?'Enviar convite':'Criar conta'} <Plus size={16}/></button>
      </form>
    </div>
    <div className="panel padded"><div className="notice-info"><ShieldCheck/>
      <div><h3>Privilégios mínimos</h3><p>Analistas consultam dados sem editar. Agentes trabalham nas oportunidades atribuídas. Registos financeiros não estão disponíveis para agentes.</p></div>
    </div></div>
  </div>
  <div className="panel"><div className="panel-head"><h3>Contas empresariais</h3></div><div className="table-wrap"><table>
    <thead><tr><th>Nome</th><th>Email</th><th>Perfil</th><th>Estado</th><th>Acção</th></tr></thead>
    <tbody>{items.map(x=><tr key={x.id}><td>{String(x.full_name)}</td><td>{String(x.email)}</td><td>{String(x.role)}</td><td><Status text={x.status}/></td>
      <td>{x.role!=='owner'&&(mail&&x.status==='disabled'&&!x.email_verified_at?<button className="text-button" onClick={()=>resend(x)}>Reenviar convite</button>:<button className="text-button" onClick={()=>toggle(x)}>{x.status==='active'?'Desactivar':'Reactivar'}</button>)}</td>
    </tr>)}{!items.length&&<tr><td colSpan={5} className="empty-cell">Sem contas.</td></tr>}</tbody>
  </table></div></div>
 </div>;
}
function AuditPage(){const[items,setItems]=useState<RecordItem[]>([]);const{notice,bad}=useNotice();useEffect(()=>{api<ListResult>('/audit').then(x=>setItems(x.items)).catch(bad);},[]);return <div className="page"><div className="page-head"><div><div className="eyebrow dark">GOVERNAÇÃO</div><h1>Registo de auditoria</h1><p>Histórico de alterações em entidades e acessos.</p></div></div>{notice&&<div className="error">{notice.message}</div>}<div className="panel"><div className="table-wrap"><table><thead><tr><th>Operação</th><th>Entidade</th><th>Identificador</th><th>Quando</th></tr></thead><tbody>{items.map(x=><tr key={x.id}><td>{String(x.action)}</td><td>{String(x.entity)}</td><td className="tiny">{String(x.entity_id||'—')}</td><td>{shortDate(x.created_at)}</td></tr>)}{!items.length&&<tr><td colSpan={4} className="empty-cell">Sem eventos.</td></tr>}</tbody></table></div></div></div>}
function SettingsPage({session}:{session:Session}){const[currentPassword,setCurrent]=useState('');const[newPassword,setNext]=useState('');const{notice,bad,ok}=useNotice();async function change(e:React.FormEvent){e.preventDefault();try{await api('/auth/change-password','POST',{currentPassword,newPassword});ok('Palavra-passe alterada. Outras sessões terminadas.');setCurrent('');setNext('');}catch(e){bad(e);}}return <div className="page"><div className="page-head"><div><div className="eyebrow dark">A SUA CONTA</div><h1>Definições</h1><p>Organização, segurança e sessão.</p></div></div><div className="two-panels"><div className="panel padded"><h3>Workspace</h3><div className="detail-row"><span>Organização</span><strong>{session.organization.name}</strong></div><div className="detail-row"><span>Slug</span><strong>{session.organization.slug}</strong></div><div className="detail-row"><span>Moeda</span><strong>{session.organization.currency}</strong></div><div className="detail-row"><span>Perfil</span><strong>{session.user.role}</strong></div></div><div className="panel padded"><h3>Alterar palavra-passe</h3>{notice&&<div className={notice.bad?'error':'success'}>{notice.message}</div>}<form onSubmit={change} className="vertical-form"><label>Palavra-passe actual<input type="password" required value={currentPassword} onChange={e=>setCurrent(e.target.value)}/></label><label>Nova palavra-passe (12+ caracteres)<input type="password" required minLength={12} value={newPassword} onChange={e=>setNext(e.target.value)}/></label><button className="primary">Actualizar credenciais <LockKeyhole size={16}/></button></form></div></div></div>}
function Main(){const[session,setSession]=useState<Session|null>(null);const[loading,setLoading]=useState(true);const[tab,setTab]=useState('overview');const[menu,setMenu]=useState(false);const{notice,bad}=useNotice();useEffect(()=>{api<Session>('/auth/me').then(setSession).catch(()=>{}).finally(()=>setLoading(false));},[]);async function signOut(){try{await api('/auth/logout','POST',{});setSession(null);setTab('overview');}catch(e){bad(e);}}if(loading)return <div className="boot"><Activity size={32}/> A carregar AtlasOps...</div>;if(!session)return <AuthPanel onLogin={setSession}/>;const Icon=ICONS[tab]||LayoutDashboard;return <div className="app"><div className={'mobile-shade '+(menu?'show':'')} onClick={()=>setMenu(false)}/><aside className={'sidebar '+(menu?'show':'')}><div className="sidebar-logo"><div className="logo-icon"><Activity size={23}/></div><b>ATLAS<span>OPS</span></b><small>INTELLIGENCE</small></div><div className="workspace-switch"><div className="workspace-avatar">{session.organization.name.charAt(0).toUpperCase()}</div><div><strong>{session.organization.name}</strong><small>{session.organization.slug}</small></div><ChevronDown size={16}/></div><nav>{GROUPS.map(([title,links])=><div className="nav-group" key={title}><div className="nav-section">{title}</div>{links.filter(x=>allowed(x,session.user.role)).map(x=>{const I=ICONS[x];return <button key={x} onClick={()=>{setTab(x);setMenu(false);}} className={'nav-link '+(tab===x?'active':'')}><I size={18}/>{LABELS[x]}{tab===x&&<span className="nav-line"/>}</button>})}</div>)}</nav><div className="sidebar-bottom"><div className="profile-avatar">{session.user.full_name.substring(0,1).toUpperCase()}</div><div className="sidebar-profile"><strong>{session.user.full_name}</strong><small>{session.user.role}</small></div><button className="icon-button exit" title="Terminar sessão" onClick={signOut}><LogOut size={18}/></button></div></aside><main className="main"><div className="topbar"><button className="icon-button menu-button" onClick={()=>setMenu(!menu)}><Menu size={21}/></button><div className="breadcrumbs"><span>Workspace</span><ChevronRight size={15}/><b>{LABELS[tab]}</b></div><div className="topbar-right"><div className="system-pill"><span className="dot"/> Sistema operacional</div><div className="top-user">{session.user.full_name.slice(0,1)}</div></div></div>{notice&&<div className="error page-error">{notice.message}</div>}{tab==='overview'?<OverviewPage session={session} setTab={setTab}/>:tab==='insights'?<InsightsPage/>:tab==='devices'?<DevicesPage/>:tab==='transcripts'?<TranscriptPage session={session}/>:tab==='carrier'?<CarrierPage/>:tab==='users'?<UsersPage/>:tab==='audit'?<AuditPage/>:tab==='settings'?<SettingsPage session={session}/>:resources[tab]?<Collection key={tab} kind={tab} session={session}/>:<div className="page"><h1>Em construção</h1></div>}</main></div>;}

createRoot(document.getElementById('root')!).render(<React.StrictMode><Main/></React.StrictMode>);
