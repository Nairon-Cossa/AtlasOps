# ============================================================
# ATLASOPS - ENVIRONMENT CONFIGURATION
# ============================================================

# DATABASE

POSTGRES_PASSWORD=change-this-to-a-long-random-admin-password

POSTGRES_APP_PASSWORD=change-this-to-a-different-long-runtime-password

DATABASE_URL=postgres://atlasops_runtime:change-this-to-a-different-long-runtime-password@db:5432/atlasops


# APPLICATION

NODE_ENV=development

PORT=4000

HOST=0.0.0.0

PUBLIC_ORIGIN=http://localhost:18080


# REGISTRATION
# invite = requires global invite code
# open = public registration with email verification

SIGNUP_MODE=invite

SIGNUP_INVITE_CODE=change-this-bootstrap-invite-secret


# SESSIONS

SESSION_COOKIE_NAME=ao_session


# TRANSACTIONAL EMAIL
# Requires a verified sender domain

RESEND_API_KEY=

EMAIL_FROM=AtlasOps <contas@example.com>


# OPTIONAL AI INTEGRATION

OPENAI_API_KEY=

OPENAI_MODEL=


# TRANSCRIPT ENCRYPTION
# Base64-encoded 32-byte key

TRANSCRIPT_ENCRYPTION_KEY_BASE64=